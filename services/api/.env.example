# BACKEND ONLY - never put these in the website or mobile app
PORT=4000
NODE_ENV=development
# Option A (local PostgreSQL):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/locora?schema=public"
# Option B (hosted free Postgres, e.g. Neon): paste the connection string from the provider dashboard instead, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000"
# DEV ONLY: used by the seed script to create the first admin. Remove before deployment.
SEED_ADMIN_EMAIL="admin@locora.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Image storage (Cloudinary) - leave empty until you have an account
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Razorpay test mode - leave empty until you have test keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
